{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencursor",
  "version": "0.1.0",
  "identifier": "com.opencursor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "opencursor",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
